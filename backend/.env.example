DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Local auth demo only; use run_local_demo bound to 127.0.0.1. SMS is not sent.
BERI_DEMO_REGISTRATION_ENABLED=False
# HTTPS environments: True. Only local HTTP development: False.
DJANGO_COOKIE_SECURE=True

# Local PostgreSQL. Generate a password in backend/.env; never commit it.
DB_NAME=beri
DB_USER=beri_local
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=55432
